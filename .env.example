# Copy to .env and edit. Both URLs must be exactly what browsers type (scheme, host, port).
IDP_PUBLIC_URL=http://localhost:9000
GATE_PUBLIC_URL=http://localhost:9080
IDP_PORT=9000
GATE_PORT=9080
# 127.0.0.1 keeps a port off the network (e.g. behind your own TLS proxy)
IDP_BIND=0.0.0.0
GATE_BIND=0.0.0.0
IDP_SESSION_HOURS=12
# dashboard wrapper origins allowed to frame the sign-in page (registered sites are always allowed)
FRAME_ANCESTORS=
# reverse proxies whose X-Forwarded-* headers are trusted (comma-separated IPs, or *)
FORWARDED_ALLOW_IPS=
# Postgres for users, sites, codes and tokens; leave DB_HOST empty for SQLite in the data volume
DB_HOST=
DB_PORT=5432
DB_NAME=idp
DB_USER=idp
DB_PASSWORD=
