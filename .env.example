# Copy to .env and edit. Both URLs must be exactly what browsers type (scheme, host, port).
IDP_PUBLIC_URL=http://localhost:9000
GATE_PUBLIC_URL=http://localhost:9080
IDP_PORT=9000
GATE_PORT=9080
# 127.0.0.1 keeps a port off the network (e.g. behind your own TLS proxy)
IDP_BIND=0.0.0.0
GATE_BIND=0.0.0.0
IDP_SESSION_HOURS=12
