# Copy to .env (gitignored) and edit. Placeholders only here: no secrets, host names or LAN addresses.

# what browsers type to reach the sign-in provider (scheme, host, port); also the token issuer
IDP_PUBLIC_URL=http://localhost:9000
# what browsers type to reach the gate in front of the demo site
GATE_PUBLIC_URL=http://localhost:9080
# host port for the provider
IDP_PORT=9000
# host port for the gate
GATE_PORT=9080
# the one IPv4 address both ports are published on: 127.0.0.1 keeps them off the network, a LAN address shares them
BIND_ADDR=127.0.0.1
# how long a sign-in lasts before the user signs in again
IDP_SESSION_HOURS=12
# space-separated client files inside the container: the committed demo client plus your own gitignored sites
IDP_CLIENTS_FILE="/config/clients.json /config/clients.local.json"
# dashboard wrapper origins allowed to frame the sign-in page, space-separated (registered sites are always allowed)
FRAME_ANCESTORS=
# reverse proxies whose X-Forwarded-* headers are trusted (comma-separated IPs, or *)
FORWARDED_ALLOW_IPS=

# Postgres for users, sites, codes and tokens.
# the database server's address; empty = SQLite in the data volume
DB_HOST=
# Postgres port
DB_PORT=5432
# database name (the role owns only this database)
DB_NAME=idp
# database role
DB_USER=idp
# the role's password (real value only in your .env)
DB_PASSWORD=

# Optional: join an existing shared Docker network instead of the stack's own (see compose.shared-network.yml).
# which compose files to load; uncomment to add the shared-network file
# COMPOSE_FILE=docker-compose.yml:compose.shared-network.yml
# separator used in COMPOSE_FILE (":" works on every OS)
# COMPOSE_PATH_SEPARATOR=:
# name of the existing external network to join
# SHARED_NETWORK=homelab
